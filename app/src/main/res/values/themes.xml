<?xml version="1.0" encoding="utf-8"?>

<resources>

    <style name="SplashTheme"
        parent="Theme.SplashScreen">

        <item name="windowSplashScreenBackground">#f2fefe</item>

        <item name="windowSplashScreenAnimatedIcon">
            @mipmap/ic_launcher
        </item>

        <item name="postSplashScreenTheme">
            @style/AppTheme
        </item>

    </style>

    <style name="AppTheme"
        parent="Theme.AppCompat.Light.NoActionBar">

        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">#16A34A</item>
        <item name="android:statusBarColor">#f2fefe</item>
        <item name="android:navigationBarColor">#f2fefe</item>
        <item name="android:windowLightStatusBar">true</item>

    </style>

</resources>
